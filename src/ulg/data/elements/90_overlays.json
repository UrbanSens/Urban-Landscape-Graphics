{
  "title": "Planning status, analysis overlays, context and fallback",
  "elements": {
    "status_planned": {
      "group": "planning",
      "geometry": [
        "polygon"
      ],
      "z": 97,
      "label": {
        "en": "Planned (new)",
        "de": "Planung (neu)"
      },
      "description": {
        "en": "Overlay for anything proposed: soft red with a cross-hatch, as the Bavarian Bauvorlagenverordnung draws new works.",
        "de": "Überlagerung für Geplantes: zartes Rot mit Kreuzschraffur, wie die BauVorlV Bayern Neubau darstellt."
      },
      "fill": "signal.planned-soft",
      "outline": "signal.planned",
      "fill_opacity": 0.4,
      "outline_width": 0.35,
      "outline_dash": [
        2.2,
        0.9
      ],
      "textures": [
        {
          "motif": "hatch",
          "ink": "signal.planned",
          "spacing": 2.4,
          "angle": 45,
          "cross": true,
          "opacity": 0.8
        }
      ],
      "attributes": {
        "status": "planned",
        "layer": "overlay"
      },
      "aliases": [
        "Neuplanung",
        "geplant",
        "Neubau",
        "Maßnahme",
        "proposed",
        "new works"
      ]
