  "attributes": {
    "sealing": {
      "values": [
        "sealed",
        "partly",
        "unsealed",
        "built"
      ],
      "meaning": "Degree of sealing in the wording of the Umweltbundesamt: full, partial (loosely laid paving, water-bound surfaces), none; 'built' = covered by a building.",
      "source": "Umweltbundesamt, Bodenversiegelung (page of 26.03.2026)",
      "evidence": "V"
    },
    "bdla_class": {
      "values": {
        "1": "vegetation on natural soil",
        "2": "vegetation over structures",
        "3": "partly sealed, permeable",
        "4": "fully sealed, impermeable",
        "5": "built over (with or without green roof)"
      },
      "source": "bdla, Der qualifizierte Freiflächengestaltungsplan (Stand Juli 2022)",
      "evidence": "V",
      "note": "Standard paving laid in sand is put in class 3 here (UBA: partial sealing); some offices put it in class 4."
    },
    "bff": {
      "meaning": "Weighting factor of the Berlin Biotopflächenfaktor (0–1), current list with 16 surface types.",
      "source": "SenUVK Berlin, Der Biotopflächenfaktor als ökologisches Planungsinstrument (brochure, February 2021)",
      "evidence": "V"
    },
    "bff_1990": {
      "meaning": "Factor of the original 1990 list, still the basis of older BFF landscape plans.",
      "source": "BFF Gutachten 1990",
      "evidence": "V"
    },
    "runoff_cs": {
      "meaning": "Peak runoff coefficient Cs (pipe sizing, flood check).",
      "source": "DIN 1986-100:2016-12, Tabelle 9 (via a municipal reproduction)",
      "evidence": "S"
    },
    "runoff_cm": {
      "meaning": "Mean runoff coefficient Cm (retention and infiltration volumes, T = 2 a).",
      "source": "DIN 1986-100:2016-12, Tabelle 9 (via a municipal reproduction)",
      "evidence": "S"
    },
    "albedo": {
      "meaning": "Broadband albedo at 60 degrees solar zenith angle.",
      "source": "PALM model system 6.0 lookup tables (Gehrke et al. 2021)",
      "evidence": "V",
      "note": "PALM uses one placeholder (0.17) for most pavements; treat material differences with care."
    },
    "emissivity": {
      "source": "PALM model system 6.0 lookup tables",
      "evidence": "V"
    },
    "belagsklasse": {
      "values": {
        "1": "extreme impact (asphalt, concrete, sealed joints, plastics)",
        "2": "high (slabs, interlocking, clinker, large setts)",
        "3": "medium (small and mosaic setts)",
        "4": "low (grass pavers, water-bound, gravel, gravel turf)"
      },
      "source": "Berlin Umweltatlas 01.02 Versiegelung (2017), Tab. 1",
      "evidence": "V"
    },
    "nrr_urban_green": {
      "meaning": "Counts as urban green space under Regulation (EU) 2024/1991 Art. 3(20) as measured in the Copernicus baseline: CLC+ Backbone classes 2, 3, 4, 5, 6, 8 and 10 (trees, bushes and shrubs including vines, permanent herbaceous vegetation, lichens and mosses, water). Arable land, sealed and bare ground, railway tracks and green roofs do not count there. Built pools are excluded here as sealed technical basins (house reading of 'ponds and watercourses').",
      "source": "Regulation (EU) 2024/1991; Commission/EEA note on the urban ecosystem indicators",
      "evidence": "V"
    },
    "layer": {
      "values": [
        "ground",
        "roof",
        "overlay"
      ],
      "meaning": "ground = land cover that tiles the plot; roof = lies on a building (green roofs, PV); overlay = drawn over other features and never counted as land cover."
    },
    "biodiversity": {
      "meaning": "Rough house heuristic 1–5 for quick maps and legend order. Not a valuation: use the BKompV or BayKompV values from the crosswalks for that.",
      "evidence": "house"
    },
    "is_complex": {
      "meaning": "The element stands for a whole complex (park, garden, residential area) rather than one surface."
    }
  },
